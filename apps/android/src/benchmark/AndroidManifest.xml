<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="com.bks.benchmark.permission.BENCHMARK_DATA"
        android:protectionLevel="signature" />

    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <profileable android:shell="true" />

        <provider
            android:name=".benchmark.BenchmarkDataProvider"
            android:authorities="com.bks.benchmark.benchmark-data"
            android:exported="true"
            android:permission="com.bks.benchmark.permission.BENCHMARK_DATA" />
    </application>
</manifest>

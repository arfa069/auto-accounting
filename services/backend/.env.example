# Copy this file to .env for local development. Do not commit the real .env file.
# Process environment variables override values from this file.
# Set AUTO_ACCOUNTING_ENV_FILE in the process environment to load another file.

# Trust proxy headers only when the backend binds to a loopback host and all
# traffic comes from the configured reverse proxy.
AUTO_ACCOUNTING_HOST=0.0.0.0
AUTO_ACCOUNTING_PORT=8080
AUTO_ACCOUNTING_TRUST_PROXY_HEADERS=false

AUTO_ACCOUNTING_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/auto_accounting
AUTO_ACCOUNTING_DATABASE_USER=auto_accounting
AUTO_ACCOUNTING_DATABASE_PASSWORD=

# Optional real-PostgreSQL multi-process migration test. Use a non-production database.
# The test creates and removes only its own isolated codex_migration_test_* schema.
AUTO_ACCOUNTING_POSTGRES_TEST_URL=
AUTO_ACCOUNTING_POSTGRES_TEST_USER=
AUTO_ACCOUNTING_POSTGRES_TEST_PASSWORD=

# Must contain at least 32 characters.
AUTO_ACCOUNTING_AUTH_PEPPER=

# SMS Provider configuration. Supported values: webhook, aliyun_pnvs (or aliyun)
AUTO_ACCOUNTING_SMS_PROVIDER=webhook
AUTO_ACCOUNTING_SMS_WEBHOOK_URL=
AUTO_ACCOUNTING_SMS_API_KEY=

# Aliyun PNVS (SMS Verify) configuration (used when AUTO_ACCOUNTING_SMS_PROVIDER=aliyun_pnvs)
AUTO_ACCOUNTING_SMS_ALIYUN_ACCESS_KEY_ID=
AUTO_ACCOUNTING_SMS_ALIYUN_ACCESS_KEY_SECRET=
AUTO_ACCOUNTING_SMS_SIGN_NAME=
AUTO_ACCOUNTING_SMS_TEMPLATE_CODE=
AUTO_ACCOUNTING_SMS_SCHEME_NAME=

# Email verification. Keep real SMTP credentials only in the ignored local .env
# or process environment. Security accepts starttls or ssl.
AUTO_ACCOUNTING_EMAIL_PROVIDER=smtp
AUTO_ACCOUNTING_SMTP_HOST=
AUTO_ACCOUNTING_SMTP_PORT=587
AUTO_ACCOUNTING_SMTP_USERNAME=
AUTO_ACCOUNTING_SMTP_PASSWORD=
AUTO_ACCOUNTING_SMTP_FROM=
AUTO_ACCOUNTING_SMTP_SECURITY=starttls

# 云端 AI 配置。实际密钥只应保存在已被 Git 忽略的本地 .env 或进程环境变量中。
# 未填写 AUTO_ACCOUNTING_AI_PROTOCOL 时，后端不会启用云端 AI 分类。
#
# 请求协议。启用云端 AI 时必填，可选值：
# - openai-responses：OpenAI Responses API
# - openai-chat-completions：兼容 OpenAI Chat Completions 的服务，例如 DeepSeek
# - anthropic-messages：兼容 Anthropic Messages API 的服务
AUTO_ACCOUNTING_AI_PROTOCOL=

# 完整的 API 请求地址。启用云端 AI 时必填，必须包含具体接口路径。
# 生产环境仅允许 HTTPS；本机测试可以使用 localhost HTTP。
# 示例：
# - OpenAI Responses：https://api.openai.com/v1/responses
# - DeepSeek Chat Completions：https://api.deepseek.com/chat/completions
# - Anthropic Messages：https://api.anthropic.com/v1/messages
AUTO_ACCOUNTING_AI_ENDPOINT=

# Provider API Key。启用云端 AI 时必填；不要把真实值写入或提交到此示例文件。
AUTO_ACCOUNTING_AI_API_KEY=

# Provider 提供的模型 ID。启用云端 AI 时必填，必须与服务商控制台中的名称完全一致。
# 示例：gpt-4o-mini、deepseek-v4-flash、claude-haiku-4-5；实际可用模型以服务商为准。
AUTO_ACCOUNTING_AI_MODEL=

# 鉴权方式。选填，可选值：bearer、x-api-key、api-key。
# 留空时按协议自动选择：OpenAI 两种协议使用 bearer，Anthropic Messages 使用 x-api-key。
AUTO_ACCOUNTING_AI_AUTH_STYLE=

# 结构化输出方式。选填，可选值：json-schema、json-object、prompt-only。
# 留空时：OpenAI Responses 和 Anthropic Messages 使用 json-schema；
# OpenAI Chat Completions 使用 json-object。
# 协议支持范围：
# - openai-responses：json-schema、prompt-only
# - openai-chat-completions：json-object、prompt-only
# - anthropic-messages：json-schema、prompt-only
# 不兼容的协议与输出方式组合会导致云端 AI 配置被拒绝。
AUTO_ACCOUNTING_AI_OUTPUT_MODE=

# 推理模式。选填，可选值：enabled、disabled、unspecified，默认 unspecified。
# 当前仅 openai-chat-completions 支持 enabled 或 disabled；
# openai-responses 与 anthropic-messages 必须保持 unspecified。
AUTO_ACCOUNTING_AI_REASONING_MODE=unspecified

# Anthropic API 版本。选填，格式为 YYYY-MM-DD；默认值为 2023-06-01。
# 该值会作为 anthropic-version 请求头发送，使用其他协议时保留默认值即可。
AUTO_ACCOUNTING_AI_API_VERSION=2023-06-01

# 建立连接的超时时间，单位为毫秒。选填，允许范围 1-300000，默认 5000。
AUTO_ACCOUNTING_AI_CONNECT_TIMEOUT_MILLIS=5000

# 等待接口响应的超时时间，单位为毫秒。选填，允许范围 1-300000，默认 60000。
AUTO_ACCOUNTING_AI_READ_TIMEOUT_MILLIS=60000

# WeChat Open Platform mobile-app credentials. AppSecret stays on the backend;
# only the public AppID may also be provided to the Android build locally.
AUTO_ACCOUNTING_WECHAT_APP_ID=
AUTO_ACCOUNTING_WECHAT_APP_SECRET=

* text=auto

# Source code, configuration, and documentation use LF on every platform.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.pro text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
deploy/termux/services/**/run text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
gradlew text eol=lf

# Windows command scripts use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be newline-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.jar binary
*.apk binary
*.jks binary
*.keystore binary
*.pdf binary
